{
  "name": "spacetodo-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun build ./src/index.ts --target=bun --outdir=dist --external pg-native --minify",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src",
    "lint:fix": "biome check ./src --fix"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "openid-client": "^5.7.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/sequelize": "^4.28.20",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.9.3"
  }
}
