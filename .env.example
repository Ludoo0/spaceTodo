# Postgres
POSTGRES_PASSWORD=change-me

# Express session cookie secret - generate e.g. with: openssl rand -hex 32
SESSION_SECRET=change-me

# Port on the host under which the app should be reachable
HTTP_PORT=8080

# Set to "true" once the app runs behind HTTPS (recommended in production)
COOKIE_SECURE=false

# The externally reachable URL of the frontend (used for post-login redirect + CORS)
FRONTEND_URL=http://localhost:8080

# --- OIDC ---
# Issuer URL of your identity provider (Keycloak, Authentik, Zitadel, Google, Azure AD, ...)
# Must serve /.well-known/openid-configuration
OIDC_ISSUER_URL=https://idp.example.com/realms/myrealm

# Client credentials as registered with the identity provider
OIDC_CLIENT_ID=spacetodo
OIDC_CLIENT_SECRET=change-me

# Must exactly match the redirect URI registered with the identity provider
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

OIDC_SCOPES=openid profile email
